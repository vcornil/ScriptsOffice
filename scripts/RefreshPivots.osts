{"version":"0.3.0","body":"\nfunction main(workbook: ExcelScript.Workbook): string {\n    const application = workbook.getApplication();\n    const originalMode = application.getCalculationMode();\n\n    let refreshed = 0;\n    const failures: string[] = [];\n\n    try {\n        application.setCalculationMode(\n            ExcelScript.CalculationMode.manual\n        );\n\n        for (const sheet of workbook.getWorksheets()) {\n            for (const pivot of sheet.getPivotTables()) {\n                try {\n                    console.log(\n                        `Refreshing \"${pivot.getName()}\" on \"${sheet.getName()}\"`\n                    );\n\n                    pivot.refresh();\n                    refreshed++;\n                } catch (error) {\n                    failures.push(\n                        `${sheet.getName()} → ${pivot.getName()}: ${String(error)}`\n                    );\n                }\n            }\n        }\n    } finally {\n        // Always restore the workbook's original calculation mode.\n        application.setCalculationMode(originalMode);\n    }\n\n    if (failures.length > 0) {\n        return `${refreshed} PivotTable(s) refreshed. ` +\n            `${failures.length} failed:\\n${failures.join(\"\\n\")}`;\n    }\n\n    return `${refreshed} PivotTable(s) refreshed successfully.`;\n}","description":"Refresh all pivots of active workbook","parameterInfo":"{\"version\":1,\"originalParameterOrder\":[],\"parameterSchema\":{\"type\":\"object\",\"default\":{},\"x-ms-visibility\":\"internal\"},\"returnSchema\":{\"type\":\"object\",\"properties\":{\"result\":{\"type\":\"string\"}}},\"signature\":{\"comment\":\"\",\"parameters\":[{\"name\":\"workbook\",\"comment\":\"\"}]}}","apiInfo":"{\"variant\":\"synchronous\",\"variantVersion\":2}"}