{"version":"0.3.0","body":"\nfunction main(workbook: ExcelScript.Workbook, prefix: string): string {\n    prefix = prefix.trim();\n\n    if (!prefix) {\n        throw new Error(\"Please provide a non-empty sheet prefix.\");\n    }\n\n    const sheets = workbook.getWorksheets();\n    const matches = sheets.filter(sheet =>\n        sheet.getName().toLowerCase().startsWith(prefix.toLowerCase())\n    );\n\n    const nonMatches = sheets.filter(sheet => !matches.includes(sheet));\n\n    // Excel requires at least one visible worksheet.\n    if (nonMatches.length === 0) {\n        throw new Error(\n            \"All worksheets match this prefix. Excel requires at least one visible sheet.\"\n        );\n    }\n\n    // Ensure a non-matching sheet remains visible and active.\n    const keeper = nonMatches[0];\n    keeper.setVisibility(ExcelScript.SheetVisibility.visible);\n    keeper.activate();\n\n    matches.forEach(sheet => {\n        sheet.setVisibility(ExcelScript.SheetVisibility.hidden);\n    });\n\n    return `${matches.length} sheet(s) starting with \"${prefix}\" were hidden.`;\n}","description":"Hide all sheets starting with provided prefix","parameterInfo":"{\"version\":1,\"originalParameterOrder\":[{\"name\":\"prefix\",\"index\":0}],\"parameterSchema\":{\"type\":\"object\",\"required\":[\"prefix\"],\"properties\":{\"prefix\":{\"type\":\"string\"}}},\"returnSchema\":{\"type\":\"object\",\"properties\":{\"result\":{\"type\":\"string\"}}},\"signature\":{\"comment\":\"\",\"parameters\":[{\"name\":\"workbook\",\"comment\":\"\"},{\"name\":\"prefix\",\"comment\":\"\"}]}}","apiInfo":"{\"variant\":\"synchronous\",\"variantVersion\":2}"}