{"version":"0.3.0","body":"\nfunction main(workbook: ExcelScript.Workbook) {\n    workbook.getWorksheets().forEach(sheet => {\n        sheet.setVisibility(ExcelScript.SheetVisibility.visible);\n    });\n}","description":"Unhide all sheets of active workbook","parameterInfo":"{\"version\":1,\"originalParameterOrder\":[],\"parameterSchema\":{\"type\":\"object\",\"default\":{},\"x-ms-visibility\":\"internal\"},\"returnSchema\":{\"type\":\"object\",\"properties\":{}},\"signature\":{\"comment\":\"\",\"parameters\":[{\"name\":\"workbook\",\"comment\":\"\"}]}}","apiInfo":"{\"variant\":\"synchronous\",\"variantVersion\":2}"}